# Configuração pública do site (sem segredos — este arquivo vai para o git).
# Para outro ambiente, crie .env.local (ignorado pelo git) ou .env.<modo>
# sobrescrevendo só o que mudar. Ex.: domínio próprio → VITE_BASE=/ e VITE_SITE_URL=https://void.com.br/

# Caminho em que o site é servido (GitHub Pages: /<repositório>/). Sempre com / no fim.
VITE_BASE=/Void-WebPage/

# URL pública completa, usada no compartilhamento (WhatsApp, LinkedIn…) e no canonical. Com / no fim.
VITE_SITE_URL=https://grupo-s-void.github.io/Void-WebPage/

# Aplicativo VOID Control.
VITE_CONTROL_URL=https://grupo-s-void.github.io/Void-Control/#/inicio
